{
  "name": "fleet-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "tsx src/server/index.ts",
    "start:prod": "node dist-server/index.js",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@types/leaflet": "^1.9.22",
    "@vercel/blob": "^2.9.0",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
